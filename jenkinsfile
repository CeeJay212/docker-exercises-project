pipeline {
  agent any
  stages {
    stage('checkout') {
      steps {
         // your git checkout step
        git branch: 'main', url: 'https://github.com/CeeJay212/docker-exercises-project.git'
      }
    }
    stage('test & docker build') {
      steps {
        // your docker image build
        sh 'docker build -t docker-exercises-my-app:latest .'
      }
    }
    stage('docker login') {
      steps {
        // your docker login withCredentials
        withCredentials([usernamePassword(credentialsId: 'Docker-hub-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh ' echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
        }
      }
    }
    stage('docker image tag') {
      steps {
        // your docker image tag
        sh 'docker tag docker-exercises-my-app:latest ceejay212/docker-exercises:1.0'
      }
    }
    stage('docker image push') {
      steps {
        // your docker image tag
        sh 'docker push ceejay212/docker-exercises:1.0'
      }
    }
  }
}